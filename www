<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Nuestra Boda</title>
    <!-- Librerías por CDN para previsualización y offline offline en APK via npm/CDN estático -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <!-- Fuentes Elegantes -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <style>
        /* TEMA 1: ROMÁNTICO PASTEL (Por Defecto - Lilas, Rosas, Salmón) */
        :root, body.theme-romantico {
            --bg-app: #FFF7F8;             
            --theme-primary: #C5A3C7;      
            --theme-light: #F4EBF5;        
            --theme-secondary: #FDE2E4;    
            --theme-accent: #FFB5A7;       
            --color-text-main: #4A4545;
            --color-text-muted: #9E9494;
            --color-bg-card: #FFFFFF;
            --color-bg-input: #FCF4F4;
            --color-danger: #F2B8B5;
            --color-border: #F7EBEB;
        }

        /* TEMA 2: CAMPESTRE (Verdes Salvia y Dorado) */
        body.theme-campestre {
            --bg-app: #FDFBF8;
            --theme-primary: #A9BCA5;
            --theme-light: #E9EFE8;
            --theme-secondary: #F2E4E4;
            --theme-accent: #D6BD7D;
            --color-text-main: #4A4A4A;
            --color-text-muted: #8C8C8C;
            --color-bg-card: #FFFFFF;
            --color-bg-input: #F8F8F8;
            --color-danger: #E6A5A5;
            --color-border: #F0F0F0;
        }

        /* TEMA 3: PLAYA (Azul pastel, Arena, Melocotón) */
        body.theme-playa {
            --bg-app: #F4F7F8;
            --theme-primary: #9FB8D0;
            --theme-light: #E8F0F6;
            --theme-secondary: #FDE8D4;
            --theme-accent: #F4C2A1;
            --color-text-main: #3D4A54;
            --color-text-muted: #8B9CA8;
            --color-bg-card: #FFFFFF;
            --color-bg-input: #F0F4F6;
            --color-danger: #F2B8B5;
            --color-border: #E8EEF2;
        }

        /* MODO OSCURO (Elegante para cualquier tema) */
        body.dark-mode {
            --bg-app: #1A1818;
            --color-bg-card: #242121;
            --color-bg-input: #2E2929;
            --color-text-main: #F0EFEB;
            --color-text-muted: #A39D9D;
            --color-border: #3A3535;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Montserrat', sans-serif; -webkit-tap-highlight-color: transparent; }
        
        body { background-color: var(--bg-app); color: var(--color-text-main); overflow: hidden; height: 100vh; display: flex; flex-direction: column; transition: background-color 0.4s ease, color 0.4s ease; }
        
        .font-title { font-family: 'Playfair Display', serif; font-weight: 600; letter-spacing: 0.5px; }
        
        /* Layout Principal con Animación */
        .view-container { 
            display: flex; flex-direction: column; height: 100%; padding-bottom: 75px; 
            animation: fadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .hidden { display: none !important; }
        .scrollable { overflow-y: auto; padding: 25px 20px; flex: 1; scroll-behavior: smooth; }

        /* Componentes - Tarjetas Suaves */
        .card { 
            background: var(--color-bg-card); 
            border-radius: 24px; 
            padding: 24px; 
            margin-bottom: 18px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.03); 
            border: none;
            transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.4s ease;
        }
        .flex { display: flex; }
        .justify-between { justify-content: space-between; }
        .items-center { align-items: center; }
        .text-center { text-align: center; }
        .text-muted { color: var(--color-text-muted); font-size: 13px; font-weight: 400; }
        
        /* Botones y Formularios Redondeados */
        button { cursor: pointer; border: none; outline: none; background: none; transition: all 0.2s ease; }
        button:active { transform: scale(0.95); opacity: 0.8; }
        
        .btn-primary { background: var(--theme-primary); color: white; padding: 16px 28px; border-radius: 30px; font-size: 15px; font-weight: 500; width: 100%; letter-spacing: 0.5px; box-shadow: 0 8px 20px rgba(0,0,0,0.08); }
        .btn-outline { border: 1.5px solid var(--theme-primary); color: var(--theme-primary); padding: 14px 24px; border-radius: 30px; font-size: 14px; font-weight: 500; width: 100%; }
        
        .fab { position: fixed; bottom: 95px; right: 25px; width: 64px; height: 64px; background: var(--theme-accent); border-radius: 50%; color: white; font-size: 28px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); display: flex; align-items: center; justify-content: center; z-index: 100; font-family: sans-serif; transition: background 0.4s ease; }
        
        input, select { width: 100%; padding: 16px 20px; border-radius: 16px; border: none; background: var(--color-bg-input); color: var(--color-text-main); font-size: 15px; margin-bottom: 16px; outline: none; transition: background 0.3s, box-shadow 0.3s; }
        input:focus, select:focus { background: var(--color-bg-card); box-shadow: 0 0 0 2px var(--theme-light); }
        
        /* Navegación Inferior */
        .bottom-nav { 
            position: fixed; bottom: 0; width: 100%; height: 75px; 
            background: var(--color-bg-card); 
            display: flex; justify-content: space-around; align-items: center; 
            box-shadow: 0 -10px 30px rgba(0,0,0,0.04); 
            z-index: 100; 
            border-radius: 30px 30px 0 0;
            transition: background-color 0.4s ease;
        }
        .bottom-nav button { flex: 1; display: flex; flex-direction: column; align-items: center; color: var(--color-text-muted); font-size: 11px; padding: 10px 0; font-weight: 500; }
        .bottom-nav button.active { color: var(--theme-primary); }
        .bottom-nav svg { width: 22px; height: 22px; margin-bottom: 6px; fill: currentColor; transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
        .bottom-nav button.active svg { transform: translateY(-4px) scale(1.1); }

        /* Wizard */
        .wizard-step { height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 40px; text-align: center; animation: fadeIn 0.6s ease-out; }
        .wizard-controls { position: absolute; bottom: 60px; width: calc(100% - 80px); display: flex; justify-content: space-between; gap: 15px;}

        /* Inicio / Dashboard */
        .hero-countdown { 
            background: linear-gradient(135deg, var(--theme-secondary) 0%, var(--theme-light) 100%); 
            border-radius: 30px; padding: 45px 20px; color: var(--color-text-main); 
            margin-bottom: 25px; position: relative; overflow: hidden; 
            box-shadow: 0 15px 35px rgba(0,0,0,0.04);
            transition: background 0.5s ease;
        }
        .progress-bar { height: 8px; background: var(--color-bg-input); border-radius: 10px; overflow: hidden; margin-top: 15px; }
        .progress-fill { height: 100%; background: var(--theme-primary); transition: width 1s cubic-bezier(0.4, 0, 0.2, 1); border-radius: 10px; }

        /* Presupuesto y Tabs */
        .budget-header { position: sticky; top: 0; background: var(--bg-app); z-index: 10; padding: 25px 20px 10px; transition: background 0.4s ease; }
        .tabs { display: flex; background: var(--color-bg-card); border-radius: 16px; padding: 5px; margin-bottom: 20px; box-shadow: 0 8px 24px rgba(0,0,0,0.03); }
        .tab { flex: 1; padding: 14px; text-align: center; font-weight: 500; color: var(--color-text-muted); font-size: 14px; border-radius: 12px; transition: all 0.3s; cursor: pointer;}
        .tab.active { background: var(--theme-light); color: var(--theme-primary); }
        
        .category-item { background: var(--color-bg-card); border-radius: 20px; margin-bottom: 15px; overflow: hidden; box-shadow: 0 8px 24px rgba(0,0,0,0.02); transition: all 0.3s ease; }
        .cat-head { padding: 20px; display: flex; justify-content: space-between; align-items: center; font-weight: 500; font-size: 15px; cursor: pointer; }
        .cat-body { padding: 0 20px; display: none; }
        .category-item.expanded { box-shadow: 0 12px 30px rgba(0,0,0,0.06); transform: translateY(-2px); }
        .category-item.expanded .cat-body { display: block; padding-bottom: 15px; animation: fadeIn 0.4s ease; }
        .expense-row { display: flex; justify-content: space-between; align-items: center; padding: 15px 0; border-bottom: 1px solid var(--color-border); }
        .expense-row:last-child { border-bottom: none; }
        .status-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; margin-right: 12px; }
        .status-pendiente { background: var(--color-danger); }
        .status-abonado { background: var(--theme-accent); }
        .status-pagado { background: var(--theme-primary); }
        .badge-apadrinado { font-size: 10px; background: var(--theme-accent); color: white; padding: 4px 10px; border-radius: 12px; margin-left: 10px; font-weight: 600; letter-spacing: 0.3px;}
        .delete-btn { color: var(--color-danger); font-size: 22px; padding: 5px; margin-left: 12px; line-height: 1; }

        /* Calendario & Agenda */
        .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; text-align: center; margin-bottom: 25px; }
        .calendar-day-header { font-weight: 500; font-size: 11px; text-transform: uppercase; color: var(--color-text-muted); padding: 5px; letter-spacing: 0.5px;}
        .calendar-day { padding: 12px 5px; border-radius: 14px; font-size: 14px; position: relative; background: var(--color-bg-input); transition: background 0.3s; font-weight: 500;}
        .calendar-day.has-event { font-weight: 600; color: var(--theme-primary); background: var(--theme-light); }
        .calendar-day.has-event::after { content: ''; position: absolute; bottom: 6px; left: 50%; transform: translateX(-50%); width: 5px; height: 5px; background: var(--theme-primary); border-radius: 50%; }
        
        .task-item { display: flex; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--color-border); cursor: pointer; transition: opacity 0.3s; }
        .task-item:last-child { border-bottom: none; }
        .task-checkbox { width: 26px; height: 26px; border: 2px solid var(--theme-primary); border-radius: 50%; margin-right: 18px; display: flex; justify-content: center; align-items: center; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); flex-shrink: 0; }
        .task-item.completed .task-checkbox { background: var(--theme-primary); transform: scale(1.1);}
        .task-item.completed .task-checkbox::after { content: '✓'; font-size: 14px; color: white; }
        .task-item.completed span { text-decoration: line-through; color: var(--color-text-muted); }

        /* Invitados y Mesas */
        .guest-card { display: flex; justify-content: space-between; align-items: center; padding: 18px; background: var(--color-bg-card); border-radius: 20px; margin-bottom: 14px; box-shadow: 0 8px 24px rgba(0,0,0,0.03); transition: transform 0.2s; }
        .guest-card:active { transform: scale(0.98); }
        .btn-icon { background: var(--theme-light); color: var(--theme-primary); border-radius: 50%; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; margin-right: 5px; transition: background 0.3s;}
        
        .table-dropzone { min-height: 130px; background: var(--color-bg-input); border-radius: 20px; padding: 18px; margin-bottom: 25px; transition: background 0.3s; border: 2px dashed transparent;}
        .table-dropzone.highlight { background: var(--theme-light); border-color: var(--theme-primary); }
        .guest-drag-item { background: var(--color-bg-card); padding: 12px 18px; border-radius: 14px; margin-bottom: 12px; font-size: 14px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); cursor: grab; font-weight: 500; }
        .guest-drag-item:active { cursor: grabbing; box-shadow: 0 8px 25px rgba(0,0,0,0.1); transform: scale(1.02);}

        /* Inspiración (Moodboard) */
        .masonry-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; }
        .masonry-item { border-radius: 20px; overflow: hidden; position: relative; box-shadow: 0 8px 25px rgba(0,0,0,0.08); }
        .masonry-item img { width: 100%; height: auto; display: block; object-fit: cover; }
        .masonry-item .delete-img { position: absolute; top: 10px; right: 10px; background: rgba(0,0,0,0.5); color: white; border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; font-size: 14px; backdrop-filter: blur(5px); }

        /* Modales */
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); z-index: 200; display: none; justify-content: center; align-items: flex-end; }
        .modal-overlay.active { display: flex; animation: fadeInModal 0.4s ease; }
        .modal-content { background: var(--color-bg-card); width: 100%; max-height: 85vh; overflow-y: auto; border-radius: 35px 35px 0 0; padding: 35px 25px 45px; animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1); box-shadow: 0 -15px 40px rgba(0,0,0,0.1); }
        
        @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
        @keyframes fadeInModal { from { opacity: 0; } to { opacity: 1; } }

        /* Notificación Toast */
        .toast { position: fixed; top: 30px; left: 50%; transform: translateX(-50%); background: var(--color-text-main); color: var(--color-bg-card); padding: 14px 28px; border-radius: 30px; font-size: 14px; font-weight: 500; z-index: 300; opacity: 0; transition: opacity 0.4s, transform 0.4s; pointer-events: none; box-shadow: 0 10px 25px rgba(0,0,0,0.2); transform: translate(-50%, -20px);}
        .toast.show { opacity: 1; transform: translate(-50%, 0); }

        /* Confeti */
        .confetti { position: fixed; width: 10px; height: 20px; z-index: 1000; animation: fall 3s linear forwards; border-radius: 6px; }
        @keyframes fall { to { transform: translateY(100vh) rotate(720deg); } }

        /* Sub-pantallas del menú Más */
        .sub-screen { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: var(--bg-app); z-index: 50; animation: slideLeft 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
        @keyframes slideLeft { from { transform: translateX(30px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

        /* Impresión (PDF) */
        @media print {
            body { overflow: visible !important; height: auto !important; background: white; color: black; font-family: sans-serif;}
            .bottom-nav, .fab, .wizard-controls, button, .tabs, .hero-countdown, .modal-overlay, .delete-btn { display: none !important; }
            .view-container, .scrollable, .sub-screen { display: block !important; overflow: visible !important; position: static !important; padding: 0 !important; animation: none !important; }
            .hidden { display: block !important; }
            #wizard-view, #inicio-screen, #mas-screen, #proveedores-screen, #inspiracion-screen, #ajustes-screen { display: none !important; }
            .card, .category-item, .guest-card { box-shadow: none !important; border: 1px solid #ddd !important; page-break-inside: avoid; margin-bottom: 10px; border-radius: 10px !important;}
            .cat-body { display: block !important; }
            .budget-header { position: static !important; border-bottom: 2px solid black; background: white; padding: 0 0 15px; margin-bottom: 20px;}
        }
    </style>
</head>
<body class="theme-romantico">

    <!-- ================== WIZARD (Asistente Inicial) ================== -->
    <div id="wizard-view" class="view-container">
        <!-- Paso 1 -->
        <div id="step-1" class="wizard-step">
            <h1 class="font-title" style="font-size: 36px; margin-bottom: 10px; color: var(--theme-primary);">¡Felicidades!</h1>
            <p class="text-muted" style="margin: 10px 0 40px; line-height: 1.6;">Comencemos a planear su día inolvidable. ¿Cuáles son sus nombres?</p>
            <input type="text" id="wiz-name1" placeholder="Nombre 1 (Ej. María)" style="text-align: center; font-size: 18px;">
            <span class="font-title" style="margin-bottom: 16px; font-size: 28px; color: var(--theme-accent);">&</span>
            <input type="text" id="wiz-name2" placeholder="Nombre 2 (Ej. Juan)" style="text-align: center; font-size: 18px;">
            <div class="wizard-controls">
                <div></div>
                <button class="btn-primary" style="width: auto;" onclick="Wizard.next(2)">Siguiente</button>
            </div>
        </div>
        <!-- Paso 2 -->
        <div id="step-2" class="wizard-step hidden">
            <h2 class="font-title" style="font-size: 30px; margin-bottom: 10px;">¿Dónde y Cuándo?</h2>
            <p class="text-muted" style="margin: 10px 0 40px; line-height: 1.6;">No te preocupes si aún no tienes la fecha exacta, podremos ajustarla luego.</p>
            <input type="text" id="wiz-city" placeholder="Ciudad (Ej. Armenia, Colombia)">
            <input type="date" id="wiz-date" style="color: var(--color-text-muted);">
            <div class="wizard-controls">
                <button class="btn-outline" style="width: auto;" onclick="Wizard.next(1)">Atrás</button>
                <button class="btn-primary" style="width: auto;" onclick="Wizard.next(3)">Siguiente</button>
            </div>
        </div>
        <!-- Paso 3 -->
        <div id="step-3" class="wizard-step hidden">
            <h2 class="font-title" style="font-size: 30px; margin-bottom: 10px;">Presupuesto Base</h2>
            <p class="text-muted" style="margin: 10px 0 40px; line-height: 1.6;">¿Cuánto estiman gastar en total para la boda?</p>
            <div class="flex" style="gap: 15px; width: 100%;">
                <select id="wiz-currency" style="width: 35%;">
                    <option value="COP">COP ($)</option>
                    <option value="EUR">EUR (€)</option>
                    <option value="USD">USD ($)</option>
                </select>
                <input type="number" id="wiz-budget" placeholder="Ej. 15000000" style="width: 65%;">
            </div>
            <div class="wizard-controls">
                <button class="btn-outline" style="width: auto;" onclick="Wizard.next(2)">Atrás</button>
                <button class="btn-primary" style="width: auto;" onclick="Wizard.next(4)">Siguiente</button>
            </div>
        </div>
        <!-- Paso 4 -->
        <div id="step-4" class="wizard-step hidden">
            <h2 class="font-title" style="font-size: 30px; margin-bottom: 10px;">El Estilo</h2>
            <p class="text-muted" style="margin: 10px 0 40px; line-height: 1.6;">¿Cómo imaginan su boda y qué colores prefieren para la app?</p>
            
            <input type="number" id="wiz-guests" placeholder="Número aprox. de invitados">
            
            <!-- Estilo real del evento -->
            <select id="wiz-wedding-type" style="margin-bottom: 15px;">
                <option value="" disabled selected>El estilo de su boda será...</option>
                <option value="Clásica">Boda Clásica / Tradicional</option>
                <option value="Campestre">Boda Campestre / Rústica</option>
                <option value="Playa">Boda en la Playa / Destino</option>
                <option value="Íntima">Boda Íntima / Elopement</option>
                <option value="Moderna">Boda Moderna / Minimalista</option>
            </select>

            <!-- Paleta de colores de la interfaz -->
            <select id="wiz-style">
                <option value="" disabled selected>Color para la aplicación...</option>
                <option value="theme-romantico">App: Romántico (Rosas y Lilas)</option>
                <option value="theme-campestre">App: Naturaleza (Verdes y Dorado)</option>
                <option value="theme-playa">App: Brisa (Azules y Arena)</option>
            </select>
            
            <div class="wizard-controls">
                <button class="btn-outline" style="width: auto;" onclick="Wizard.next(3)">Atrás</button>
                <button class="btn-primary" style="width: auto;" onclick="Wizard.finish()">¡Comenzar!</button>
            </div>
        </div>
    </div>

    <!-- ================== APP PRINCIPAL ================== -->
    
    <!-- 1. INICIO -->
    <div id="inicio-view" class="view-container hidden">
        <div class="scrollable">
            <div class="hero-countdown text-center">
                <button onclick="Settings.openEditConfigModal()" style="position: absolute; top: 15px; right: 15px; background: rgba(255,255,255,0.6); border-radius: 50%; width: 36px; height: 36px; font-size: 16px; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px);" title="Modificar datos">✏️</button>
                <h2 class="font-title" id="dash-names" style="font-size: 36px; margin-bottom: 8px;">M & J</h2>
                <p id="dash-date" style="font-size: 14px; font-weight: 500; opacity: 0.9; margin-bottom: 30px; text-transform: capitalize;">15 de Octubre, 2026</p>
                <div style="background: rgba(255,255,255,0.45); padding: 20px; border-radius: 20px; backdrop-filter: blur(8px);">
                    <span style="font-size: 12px; text-transform: uppercase; letter-spacing: 3px; font-weight: 600;">Faltan</span>
                    <h3 class="font-title" id="dash-countdown" style="font-size: 32px; margin-top: 8px; color: var(--theme-primary);">0 Días</h3>
                </div>
            </div>

            <div class="card">
                <div class="flex justify-between items-center" style="margin-bottom: 15px;">
                    <span class="font-title" style="font-size: 20px;">Presupuesto</span>
                    <span id="dash-budget-pct" class="text-muted" style="font-weight: 600;">0%</span>
                </div>
                <div class="progress-bar"><div class="progress-fill" id="dash-budget-bar" style="width: 0%;"></div></div>
            </div>

            <div class="card flex justify-between items-center" onclick="App.navigate('agenda')" style="cursor:pointer;">
                <div>
                    <span class="font-title" style="font-size: 20px; display: block; margin-bottom: 6px;">Tareas Listas</span>
                    <span id="dash-tasks-count" class="text-muted">0 / 0 completadas</span>
                </div>
                <div style="background: var(--theme-light); color: var(--theme-primary); padding: 14px; border-radius: 50%; font-weight: bold; font-size: 18px;">✓</div>
            </div>

            <div class="card text-center" style="background: var(--theme-secondary); color: var(--color-text-main); margin-top: 30px;">
                <p style="font-style: italic; font-size: 16px; line-height: 1.8; font-family: 'Playfair Display', serif;">"El amor se compone de una sola alma que habita en dos cuerpos."</p>
            </div>
        </div>
    </div>

    <!-- 2. PRESUPUESTO -->
    <div id="presupuesto-view" class="view-container hidden">
        <div class="budget-header">
            <div class="flex justify-between" style="margin-bottom: 12px;">
                <span class="text-muted">Total Boda: <span id="budget-total-boda" style="font-weight:600; color:var(--color-text-main);"></span></span>
                <span class="text-muted">Apadrinado: <span id="budget-total-apadrinado" style="font-weight:600; color:var(--theme-accent);"></span></span>
            </div>
