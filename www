                const msg = encodeURIComponent(`¡Hola ${name}! Queremos invitarte a nuestra boda (${conf.name1} y ${conf.name2}). Por favor confirma tu asistencia.`);
                window.open(`https://wa.me/${phone}?text=${msg}`, '_blank');
            },
            render() {
                const list = Store.get('guests');
                document.getElementById('guest-count-total').textContent = list.length;
                document.getElementById('guest-count-conf').textContent = list.filter(g => g.estado === 'Confirmado').length;
                document.getElementById('guest-count-pend').textContent = list.filter(g => g.estado === 'Pendiente').length;

                document.getElementById('guests-container').innerHTML = list.map(g => `
                    <div class="guest-card">
                        <div>
                            <div style="font-weight:600; font-size: 16px;">${g.nombre} ${g.esNino ? '🎈' : ''}</div>
                            <div class="text-muted" style="margin-top: 6px;">${g.grupo} • ${g.estado}</div>
                        </div>
                        <div class="flex items-center">
                            <button class="btn-icon" onclick="Guests.sendWA('${g.telefono}', '${g.nombre}')"><svg width="20" viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2m0 16.5c-1.45 0-2.88-.38-4.12-1.12l-.3-.17-3.08.8.83-3-.2-.33c-.79-1.25-1.21-2.71-1.21-4.25 0-4.58 3.75-8.33 8.33-8.33s8.33 3.75 8.33 8.33-3.75 8.33-8.33 8.33m4.54-5.92c-.25-.12-1.46-.71-1.67-.79-.21-.08-.38-.12-.54.12s-.62.79-.75.96c-.12.17-.29.21-.54.08-.25-.12-1.04-.38-1.98-1.23-.73-.65-1.23-1.46-1.38-1.71-.12-.25-.01-.38.12-.5.12-.12.25-.29.38-.46.12-.17.17-.29.25-.5.08-.21.04-.38-.04-.5-.08-.12-.54-1.29-.75-1.79-.21-.46-.42-.42-.54-.42H8.46c-.21 0-.54.08-.83.42-.29.33-1.08 1.04-1.08 2.54s1.12 2.96 1.29 3.17c.17.21 2.17 3.33 5.25 4.67 2.12.92 2.83.96 3.83.83 1.08-.12 3.42-1.38 3.92-2.71.5-1.33.5-2.46.33-2.71-.12-.25-.46-.38-.71-.5z"/></svg></button>
                            <button class="delete-btn" onclick="Guests.delete('${g.id}')">×</button>
                        </div>
                    </div>
                `).join('');
                this.renderMesas();
            },
            renderMesas() {
                const guests = Store.get('guests');
                const tables = Store.get('tables');
                
                const unassigned = guests.filter(g => !g.mesaId);
                document.getElementById('unassigned-count').textContent = unassigned.length;
                document.getElementById('guests-unassigned').innerHTML = unassigned.map(g => `<div class="guest-drag-item" data-id="${g.id}">${g.nombre}</div>`).join('');
                
                document.getElementById('tables-container').innerHTML = tables.map(t => {
                    const tGuests = guests.filter(g => g.mesaId === t.id);
                    return `
                    <div class="card">
                        <div class="flex justify-between items-center" style="margin-bottom:20px;">
                            <span class="font-title" style="font-size:20px; color: var(--theme-primary);">${t.name}</span>
                            <span class="text-muted">${tGuests.length} / ${t.cap} sillas</span>
                        </div>
                        <div class="table-dropzone" data-table-id="${t.id}" data-cap="${t.cap}">
                            ${tGuests.map(g => `<div class="guest-drag-item" data-id="${g.id}">${g.nombre}</div>`).join('')}
                        </div>
                    </div>`;
                }).join('');
            },
            initSortable() {
                if(typeof Sortable === 'undefined') return;
                const zones = document.querySelectorAll('.table-dropzone');
                zones.forEach(zone => {
                    new Sortable(zone, {
                        group: 'mesas', animation: 200, ghostClass: 'highlight', delay: 100, delayOnTouchOnly: true,
                        onEnd: (evt) => {
                            const guestId = evt.item.dataset.id;
                            const toZone = evt.to;
                            const newTableId = toZone.dataset.tableId === 'none' ? null : toZone.dataset.tableId;
                            
                            if(newTableId && toZone.children.length > parseInt(toZone.dataset.cap)) {
                                App.showToast("Mesa llena");
                                evt.from.appendChild(evt.item);
                                return;
                            }
                            
                            const guests = Store.get('guests');
                            const g = guests.find(i => i.id === guestId);
                            if(g) { g.mesaId = newTableId; Store.set('guests', guests); this.renderMesas(); this.initSortable(); }
                        }
                    });
                });
            }
        };

        // Hub (Más) y Submódulos
        const MoreMenu = {
            open(screenId) {
                document.getElementById('mas-screen').classList.add('hidden');
                document.getElementById(`${screenId}-screen`).classList.remove('hidden');
                if (screenId === 'proveedores') Vendors.render();
                if (screenId === 'inspiracion') Inspiration.render();
                if (screenId === 'grandia') Timeline.render();
            },
            back() {
                document.querySelectorAll('.sub-screen').forEach(el => el.classList.add('hidden'));
                document.getElementById('mas-screen').classList.remove('hidden');
            }
        };

        const Vendors = {
            openModal() { document.getElementById('modal-vendor').classList.add('active'); },
            closeModal() { document.getElementById('modal-vendor').classList.remove('active'); },
            save() {
                const nombre = document.getElementById('vendor-name').value;
                if(!nombre) return App.showToast("Ingresa un nombre");
                const list = Store.get('vendors') || [];
                list.push({ id: Utils.generateId(), nombre, cat: document.getElementById('vendor-cat').value, phone: document.getElementById('vendor-phone').value });
                Store.set('vendors', list);
                this.closeModal(); this.render();
                App.showToast("Proveedor guardado");
            },
            delete(id) {
                Store.set('vendors', Store.get('vendors').filter(v => v.id !== id));
                this.render();
                App.showToast("Proveedor eliminado");
            },
            render() {
                document.getElementById('vendors-list').innerHTML = (Store.get('vendors') || []).map(v => `
                    <div class="card flex justify-between items-center">
                        <div>
                            <div style="font-weight:600; font-size: 16px;">${v.nombre}</div>
                            <div class="text-muted" style="margin-top: 6px;">${v.cat}</div>
                        </div>
                        <div class="flex items-center">
                            ${v.phone ? `<button class="btn-icon" onclick="Guests.sendWA('${v.phone}', 'Hola, los contacto sobre mi boda')"><svg width="20" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m0 16.5c-1.45 0-2.88-.38-4.12-1.12l-.3-.17-3.08.8.83-3-.2-.33c-.79-1.25-1.21-2.71-1.21-4.25 0-4.58 3.75-8.33 8.33-8.33s8.33 3.75 8.33 8.33-3.75 8.33-8.33 8.33z"/></svg></button>` : ''}
                            <button class="delete-btn" onclick="Vendors.delete('${v.id}')">×</button>
                        </div>
                    </div>
                `).join('');
            }
        };

        const Inspiration = {
            async upload(event) {
                const file = event.target.files[0];
                if(!file) return;
                const reader = new FileReader();
                reader.onload = async (e) => {
                    await ImageStore.save(Utils.generateId(), e.target.result);
                    this.render();
                    App.showToast("Imagen guardada");
                };
                reader.readAsDataURL(file);
            },
            async delete(id) { await ImageStore.delete(id); this.render(); },
            async render() {
                const images = await ImageStore.getAll();
                document.getElementById('mood-grid').innerHTML = images.map(img => `
                    <div class="masonry-item">
                        <img src="${img.dataUrl}">
                        <button class="delete-img" onclick="Inspiration.delete('${img.id}')">✕</button>
                    </div>
                `).join('');
            }
        };

        const Timeline = {
            openModal() { document.getElementById('modal-timeline').classList.add('active'); },
            closeModal() { document.getElementById('modal-timeline').classList.remove('active'); },
            save() {
                const time = document.getElementById('tl-time').value;
                const act = document.getElementById('tl-act').value;
                if(!time || !act) return App.showToast("Faltan datos");
                const list = Store.get('timeline') || [];
                list.push({ id: Utils.generateId(), time, act, req: document.getElementById('tl-encargado').value });
                Store.set('timeline', list);
                this.closeModal(); this.render();
                App.showToast("Actividad guardada");
            },
            delete(id) { Store.set('timeline', Store.get('timeline').filter(t => t.id !== id)); this.render(); },
            render() {
                let list = Store.get('timeline') || [];
                list.sort((a,b) => a.time.localeCompare(b.time));
                document.getElementById('timeline-list').innerHTML = list.map(t => `
                    <div style="position:relative; padding-bottom:25px;">
                        <div style="position:absolute; left:-32px; top:12px; width:16px; height:16px; border-radius:50%; background:var(--theme-primary); box-shadow: 0 0 0 5px var(--theme-light);"></div>
                        <div class="card" style="margin-bottom:0; display:flex; justify-content:space-between; align-items: center; padding: 20px;">
                            <div>
                                <strong class="font-title" style="color:var(--theme-primary); font-size: 20px; margin-right: 12px;">${t.time}</strong> 
                                <span style="font-weight: 500; font-size: 16px;">${t.act}</span><br>
                                <span class="text-muted" style="font-size:13px; margin-top:8px; display:inline-block;">${t.req}</span>
                            </div>
                            <button class="delete-btn" onclick="Timeline.delete('${t.id}')">×</button>
                        </div>
                    </div>
                `).join('');
            }
        };

        // Ajustes y Config
        const Settings = {
            init() {
                const savedTheme = Store.get('app_theme') || 'theme-romantico';
                this.applyTheme(savedTheme);
                const themeSelector = document.getElementById('theme-selector');
                if(themeSelector) themeSelector.value = savedTheme;

                const isDark = Store.get('dark_mode') === true;
                document.getElementById('toggle-dark').checked = isDark;
                if(isDark) document.body.classList.add('dark-mode');
            },
            changeTheme(themeClass) {
                Store.set('app_theme', themeClass);
                this.applyTheme(themeClass);
            },
            applyTheme(themeClass) {
                document.body.classList.remove('theme-romantico', 'theme-campestre', 'theme-playa');
                document.body.classList.add(themeClass);
            },
            toggleDark() {
                const isDark = document.getElementById('toggle-dark').checked;
                if(isDark) document.body.classList.add('dark-mode');
                else document.body.classList.remove('dark-mode');
                Store.set('dark_mode', isDark);
            },
            openEditConfigModal() {
                const conf = Store.get('config');
                if(!conf) return;
                document.getElementById('cfg-name1').value = conf.name1 || '';
                document.getElementById('cfg-name2').value = conf.name2 || '';
                document.getElementById('cfg-city').value = conf.city || '';
                document.getElementById('cfg-date').value = conf.date || '';
                document.getElementById('cfg-currency').value = conf.currency || 'COP';
                document.getElementById('cfg-budget').value = conf.budget || 0;
                document.getElementById('cfg-wedding-type').value = conf.weddingStyle || 'Clásica';
                document.getElementById('modal-edit-config').classList.add('active');
            },
            closeEditConfigModal() {
                document.getElementById('modal-edit-config').classList.remove('active');
            },
            saveEditConfig() {
                const conf = Store.get('config') || {};
                conf.name1 = document.getElementById('cfg-name1').value || 'M';
                conf.name2 = document.getElementById('cfg-name2').value || 'J';
                conf.city = document.getElementById('cfg-city').value;
                conf.date = document.getElementById('cfg-date').value;
                conf.currency = document.getElementById('cfg-currency').value;
                conf.budget = parseInt(document.getElementById('cfg-budget').value) || 0;
                conf.weddingStyle = document.getElementById('cfg-wedding-type').value;

                Store.set('config', conf);
                this.closeEditConfigModal();
                Dashboard.render();
                App.showToast("Datos de la boda actualizados");
            },
            printPDF() {
                document.querySelectorAll('.category-item').forEach(el => el.classList.add('expanded'));
                window.print();
            },
            async exportJSON() {
                App.showToast("Preparando respaldo...");
                const data = {
                    config: Store.get('config'), budget: Store.get('budget'), events: Store.get('events'),
                    tasks: Store.get('tasks'), guests: Store.get('guests'), tables: Store.get('tables'),
                    vendors: Store.get('vendors'), timeline: Store.get('timeline'), app_theme: Store.get('app_theme'),
                    images: await ImageStore.getAll()
                };
                
                const blob = new Blob([JSON.stringify(data)], { type: "application/json" });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url; a.download = `Respaldo_Boda.json`;
                document.body.appendChild(a); a.click(); document.body.removeChild(a);
                URL.revokeObjectURL(url);
                App.showToast("Respaldo descargado");
            },
            importJSON(event) {
                const file = event.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = async (e) => {
                    try {
                        const data = JSON.parse(e.target.result);
                        ['config','budget','events','tasks','guests','tables','vendors','timeline', 'app_theme'].forEach(key => {
                            if(data[key]) Store.set(key, data[key]);
                        });
                        
                        if(data.images && Array.isArray(data.images)) {
                            const db = await ImageStore.initDB();
                            const tx = db.transaction(ImageStore.STORE_NAME, 'readwrite');
                            tx.objectStore(ImageStore.STORE_NAME).clear();
                            for(let img of data.images) await ImageStore.save(img.id, img.dataUrl);
                        }
                        App.showToast("¡Restaurado! Recargando...");
                        setTimeout(() => window.location.reload(), 1500);
                    } catch (err) { App.showToast("Archivo inválido"); }
                };
                reader.readAsText(file);
            }
        };

        // Iniciar la app
        document.addEventListener('DOMContentLoaded', () => {
            App.init();
        });
    </script>
</body>
</html>
