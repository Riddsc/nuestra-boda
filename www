    <script>
        // Store
        const Store = {
            get(key) { return JSON.parse(localStorage.getItem('nb_' + key)) || null; },
            set(key, value) { localStorage.setItem('nb_' + key, JSON.stringify(value)); },
            init() {
                if(!this.get('budget')) this.set('budget', []);
                if(!this.get('events')) this.set('events', []);
                if(!this.get('tasks')) this.initTasks();
                if(!this.get('guests')) this.set('guests', []);
