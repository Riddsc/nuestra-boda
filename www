        // ImageStore (IndexedDB)
        const ImageStore = {
            DB_NAME: 'NB_DB', STORE_NAME: 'images',
            initDB() {
                return new Promise((resolve, reject) => {
                    const request = indexedDB.open(this.DB_NAME, 1);
                    request.onupgradeneeded = e => { e.target.result.createObjectStore(this.STORE_NAME); };
                    request.onsuccess = e => resolve(e.target.result);
                    request.onerror = e => reject(e);
                });
            },
            async save(id, dataUrl) {
                const db = await this.initDB();
                const tx = db.transaction(this.STORE_NAME, 'readwrite');
                tx.objectStore(this.STORE_NAME).put(dataUrl, id);
                return tx.complete;
            },
            async getAll() {
                const db = await this.initDB();
                return new Promise((resolve) => {
                    const tx = db.transaction(this.STORE_NAME, 'readonly');
                    const request = tx.objectStore(this.STORE_NAME).getAll();
                    const keysRequest = tx.objectStore(this.STORE_NAME).getAllKeys();
                    tx.oncomplete = () => {
                        let res = [];
                        for(let i=0; i<request.result.length; i++) res.push({ id: keysRequest.result[i], dataUrl: request.result[i] });
                        resolve(res);
                    };
                });
            },
            async delete(id) {
                const db = await this.initDB();
                const tx = db.transaction(this.STORE_NAME, 'readwrite');
                tx.objectStore(this.STORE_NAME).delete(id);
                return tx.complete;
            }
        };

